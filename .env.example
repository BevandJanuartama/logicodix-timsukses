# ==============================================================================
# DentaScope - Environment Variables Configuration
# Salin berkas ini ke `.env` atau `.env.local` sebelum menjalankan aplikasi:
#   cp .env.example .env.local
# ==============================================================================

# [Opsional] Google Gemini API Key untuk asisten chat interaktif (Fase 20)
# Dapatkan kunci API resmi melalui Google AI Studio: https://aistudio.google.com/
# Kunci ini HANYA dibaca di server-side (Next.js route handler), tidak pernah terekspos ke klien.
# Jika dibiarkan kosong, seluruh fitur 3D tetap berfungsi penuh dan chat menampilkan pesan informatif.
GEMINI_API_KEY=

# [Opsional] Model Gemini yang digunakan (default: gemini-3.8-flash)
# Pilihan: gemini-3.8-flash, gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL=gemini-3.8-flash

# [Opsional] Aktifkan mode Vertex AI express jika kunci API diawali dengan "AQ."
# Pilihan: true | false (default: false)
GEMINI_VERTEX_EXPRESS=false

# [Opsional] URL berkas CSV jarak jauh untuk memuat/menambah katalog kondisi gigi (Fase 19)
# Format kolom rujukan dapat dilihat pada berkas `docs/conditions-template.csv`.
# Jika kosong atau gagal dimuat, aplikasi secara otomatis menggunakan dataset lokal bawaan.
CONDITIONS_CSV_URL=

# [Opsional] Label penamaan aplikasi di antarmuka publik
NEXT_PUBLIC_APP_NAME=DentaScope

# [Opsional] Filter default status review tata kelola konten (all | Approved)
NEXT_PUBLIC_DEFAULT_REVIEW_FILTER=all

