# DentaScope: variabel lingkungan
# Salin ke .env lalu isi nilainya:  cp .env.example .env
# Jangan pernah meng-commit .env berisi nilai asli.

# Kunci Google Gemini API untuk asisten chat (dibaca hanya di server, route /api/chat).
# Dapatkan di https://aistudio.google.com/apikey
# Jika kosong, semua fitur lain tetap berjalan dan chat menampilkan pesan bahwa asisten belum aktif.
GEMINI_API_KEY=

# Model Gemini pilihan. Jika kosong, server mencoba gemini-3.5-flash-lite lalu gemini-3.8-flash.
# Jika diisi, model ini dicoba lebih dulu, lalu dua model cadangan di atas.
GEMINI_MODEL=

# Isi true hanya jika GEMINI_API_KEY adalah kunci Vertex AI express mode (bukan kunci AI Studio).
GEMINI_VERTEX_EXPRESS=false

# URL CSV publik (mis. Google Sheets "Publikasikan ke web" format CSV) untuk menambah data kondisi gigi.
# Jika kosong atau gagal dimuat, aplikasi memakai 21 kondisi bawaan. Contoh kolom: docs/conditions-template.csv
CONDITIONS_CSV_URL=
